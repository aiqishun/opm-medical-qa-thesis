{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "题目的唯一标识符，例如 q0026"
    },
    "is_cardiology": {
      "type": "boolean",
      "description": "判断该题是否属于心脏病相关"
    },
    "reason": {
      "type": "string",
      "description": "模型给出该判断的具体理由"
    }
  },
  "required": ["id", "is_cardiology", "reason"],
  "additionalProperties": false
}
