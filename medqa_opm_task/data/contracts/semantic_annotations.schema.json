{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "split": {"type": "string", "enum": ["dev", "test"]},
    "id": {"type": "string", "pattern": "^q[0-9]{4}$"},
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "role": {
            "type": "string",
            "enum": [
              "primary_disease",
              "prerequisite",
              "complication",
              "manifestation",
              "past_history",
              "family_history",
              "risk_factor",
              "negation",
              "physical_sign",
              "treatment_context",
              "calculation_context",
              "distractor",
              "out_of_scope",
              "unclear"
            ]
          },
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1}
        },
        "required": ["text", "role", "start", "end"]
      }
    }
  },
  "required": ["split", "id", "annotations"]
}
