{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "records_checked": {"type": "integer", "minimum": 0},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "split": {"type": "string", "enum": ["dev", "test"]},
          "id": {"type": ["string", "null"]},
          "source_location": {"type": "string", "minLength": 1},
          "issue_type": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1}
        },
        "required": ["source_location", "issue_type", "decision"]
      }
    }
  },
  "required": ["records_checked", "issues"]
}
